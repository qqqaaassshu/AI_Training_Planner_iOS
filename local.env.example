# 复制为 local.env 后填写（local.env 不提交到仓库）：cp local.env.example local.env

# 开发团队 ID（10 位字母数字）。获取方法：Xcode 打开工程 → 选中 AITrainingPlanner target →
# Signing & Capabilities 里选择你的 Apple ID（Personal Team）→ Build Settings 搜索 Development Team，复制其中的 ID
DEVELOPMENT_TEAM=

# 标识前缀，必须全球唯一，例如 com.zhangsan2026
BUNDLE_PREFIX=com.example

# 免费 Apple ID 填 YES：去掉时效性通知与 App Group 能力，否则签名会失败
FREE_ACCOUNT=YES
